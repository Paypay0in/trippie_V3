# Gemini API Key
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Server-only Pexels API key (do not expose as a VITE_ variable)
PEXELS_API_KEY=

# Server-only. Places gives venue identity, address and price band; Routes
# gives travel time. The model is not allowed to produce either, so without
# this key those facts degrade to "needs confirmation" rather than being
# guessed — the app stays usable, but every card says it does not know.
GOOGLE_MAPS_API_KEY=

# Set by the host in production. Binding a hardcoded port makes the platform's
# health check fail against an app that is running perfectly.
PORT=3000

# Supabase public frontend configuration (never use a service-role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

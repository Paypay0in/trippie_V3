# Gemini API Key
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Server-only Pexels API key (do not expose as a VITE_ variable)
PEXELS_API_KEY=

# Server-only. Places gives venue identity, address and price band; Routes
# gives travel time. The model is not allowed to produce either, so without
# this key those facts degrade to "needs confirmation" rather than being
# guessed — the app stays usable, but every card says it does not know.
GOOGLE_MAPS_API_KEY=

# Set by the host in production. Binding a hardcoded port makes the platform's
# health check fail against an app that is running perfectly.
PORT=3000

# Supabase public frontend configuration (never use a service-role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Affiliate tracking on the booking buttons. Off until all of this is set.
#
# Not secrets: an affiliate id travels in a URL to the user's own browser and
# is visible to anyone who looks at the address bar. Kept out of the repo
# because it belongs to whoever signed the agreement, not because it needs
# protecting.
#
# One or more `name=value` pairs per provider, joined with `&`. Each pair is
# validated on its own; a malformed one is dropped and the rest still apply.
# AFFILIATE_ENABLED=true
# AFFILIATE_KLOOK=aid=123456
# AFFILIATE_KKDAY=cid=78910
# AFFILIATE_GETYOURGUIDE=partner_id=XXXXXX&travel_agent=1&cmp=share_to_earn
